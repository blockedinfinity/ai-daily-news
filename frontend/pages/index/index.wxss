.page {
  min-height: 100vh;
  padding: 0 20rpx 30rpx;
  background: linear-gradient(180deg, #f0f4ff 0%, #f5f5f5 300rpx);
}

/* ===== Header ===== */
.header {
  padding: 40rpx 10rpx 20rpx;
}

.header .title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111;
  display: block;
  letter-spacing: 1rpx;
}

.header .subtitle {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

/* ===== 日期选择器 ===== */
.date-picker {
  margin-bottom: 20rpx;
}

.date-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  padding: 4rpx 0;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.date-item.active {
  background: #1a73e8;
  box-shadow: 0 4rpx 16rpx rgba(26, 115, 232, 0.3);
}

.date-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.date-item.active .date-label {
  color: #fff;
}

.date-count {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.date-item.active .date-count {
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 加载态 ===== */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1a73e8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}

/* ===== 错误态 ===== */
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.error-text {
  font-size: 28rpx;
  color: #e74c3c;
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}

/* ===== 新闻列表 ===== */
.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.news-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.news-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: #1a73e8;
  border-radius: 0 4rpx 4rpx 0;
}

/* 序号 + 来源 */
.item-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.item-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #1a73e8, #4285f4);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.index-num {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
}

.item-source {
  font-size: 22rpx;
  color: #1a73e8;
  background: #e8f0fe;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

/* 标题 */
.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.5;
  display: block;
  padding-left: 56rpx;
}

/* 摘要预览 */
.item-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-top: 12rpx;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  padding-left: 56rpx;
}

/* 底部 */
.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-left: 56rpx;
}

.item-time {
  font-size: 22rpx;
  color: #bbb;
}

.item-action {
  font-size: 24rpx;
  color: #1a73e8;
  font-weight: 500;
}

/* 列表底部 */
.list-footer {
  text-align: center;
  padding: 30rpx 0 20rpx;
}

.list-footer-text {
  font-size: 24rpx;
  color: #bbb;
}
