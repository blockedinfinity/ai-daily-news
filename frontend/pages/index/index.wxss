.page {
  min-height: 100vh;
  padding: 0 20rpx 30rpx;
  background: #f5f5f5;
}

.header {
  padding: 40rpx 10rpx 30rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.title-group {
  flex: 1;
}

.header .title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111;
}

.header .subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.summary-btn {
  margin-top: 8rpx;
  background: #1a73e8;
  border-radius: 12rpx;
  padding: 14rpx 28rpx;
  flex-shrink: 0;
}

.summary-btn-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

.loading,
.error,
.empty {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
  font-size: 28rpx;
  color: #999;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.news-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.5;
  display: block;
}

.item-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-top: 12rpx;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-time {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 12rpx;
  display: block;
}
