.page {
  min-height: 100vh;
  padding: 0 20rpx 30rpx;
  background: linear-gradient(180deg, #f0f4ff 0%, #f5f5f5 300rpx);
}

/* ===== Header ===== */
.header {
  padding: 40rpx 10rpx 20rpx;
}

.header .title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111;
  display: block;
  letter-spacing: 1rpx;
  text-align: center;
}

.header .subtitle {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

/* ===== 日期选择器 ===== */
.date-picker {
  margin-bottom: 20rpx;
  position: relative;
}

/* 当前日期触发按钮 */
.date-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.date-trigger-left {
  display: flex;
  align-items: baseline;
}

.date-trigger-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a73e8;
}

.date-trigger-count {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
}

.date-trigger-arrow {
  font-size: 28rpx;
  color: #999;
}

.date-trigger-arrow.expanded {
  transform: rotate(180deg);
}

/* 下拉遮罩 */
.date-dropdown {
  position: relative;
  z-index: 100;
}

.date-dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
}

/* 下拉列表 */
.date-dropdown-list {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  margin-top: 8rpx;
  overflow: hidden;
}

.date-dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.date-dropdown-item:last-child {
  border-bottom: none;
}

.date-dropdown-item.active {
  background: #f0f4ff;
}

.date-dropdown-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.date-dropdown-item.active .date-dropdown-text {
  color: #1a73e8;
  font-weight: 600;
}

.date-dropdown-count {
  font-size: 22rpx;
  color: #999;
}

/* ===== 加载态 ===== */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1a73e8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}

/* ===== 错误态 ===== */
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.error-text {
  font-size: 28rpx;
  color: #e74c3c;
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}

/* ===== 新闻列表 ===== */
.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.news-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.news-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: #1a73e8;
  border-radius: 0 4rpx 4rpx 0;
}

/* 带图新闻：左右布局 */
.item-body {
  display: flex;
  gap: 20rpx;
}

.item-content {
  flex: 1;
  min-width: 0;
}

/* 右侧缩略图 */
.item-thumb {
  width: 200rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-top: 8rpx;
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 序号 + 来源 */
.item-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.item-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #1a73e8, #4285f4);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.index-num {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
}

.item-source {
  font-size: 22rpx;
  color: #1a73e8;
  background: #e8f0fe;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

/* 标题 */
.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.5;
  display: block;
  padding-left: 56rpx;
}

/* 摘要预览 */
.item-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-top: 12rpx;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  padding-left: 56rpx;
}

/* 底部 */
.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-left: 56rpx;
}

.item-time {
  font-size: 22rpx;
  color: #bbb;
}

.item-action {
  font-size: 24rpx;
  color: #1a73e8;
  font-weight: 500;
}

/* 列表底部 */
.list-footer {
  text-align: center;
  padding: 30rpx 0 40rpx;
}

.list-footer-text {
  font-size: 24rpx;
  color: #bbb;
}

/* 加载更多 */
.load-more {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 8rpx;
}

.loading-spinner.small {
  width: 32rpx;
  height: 32rpx;
  border-width: 3rpx;
  margin-right: 16rpx;
}

.load-more-text {
  font-size: 24rpx;
  color: #999;
}
