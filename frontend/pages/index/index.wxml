<view class="page">
  <!-- 顶部 Header -->
  <view class="header">
    <text class="title">Awake in AI</text>
  </view>

  <!-- 日期选择器 -->
  <view class="date-picker" wx:if="{{dates.length > 0}}">
    <!-- 当前选中日期（可点击展开） -->
    <view class="date-trigger" bind:tap="toggleDates">
      <view class="date-trigger-left">
        <text class="date-trigger-label">{{currentLabel}}</text>
        <text class="date-trigger-count">{{currentCount}} 篇</text>
      </view>
      <text class="date-trigger-arrow {{showDates ? 'expanded' : ''}}">▾</text>
    </view>

    <!-- 展开的日期列表 -->
    <view class="date-dropdown" wx:if="{{showDates}}">
      <view class="date-dropdown-mask" bind:tap="toggleDates"></view>
      <view class="date-dropdown-list">
        <view
          wx:for="{{dates}}"
          wx:key="date"
          class="date-dropdown-item {{currentDate === item.date ? 'active' : ''}}"
          bind:tap="switchDate"
          data-date="{{item.date}}"
        >
          <text class="date-dropdown-text">{{item.label}}</text>
          <text class="date-dropdown-count">{{item.count}}篇</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误态 -->
  <view class="error" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:elif="{{newsList.length === 0}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">该日期暂无新闻</text>
  </view>

  <!-- 新闻列表 -->
  <view class="list" wx:elif="{{newsList.length > 0}}">
    <view
      class="news-item {{item.image_url ? 'has-image' : ''}}"
      wx:for="{{newsList}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-title="{{item.title}}"
      data-summary="{{item.summary}}"
      data-url="{{item.url}}"
      bind:tap="goDetail"
    >
      <view class="item-body">
        <!-- 左侧内容 -->
        <view class="item-content">
          <!-- 序号 + 来源 -->
          <view class="item-header">
            <view class="item-index">
              <text class="index-num">{{index + 1}}</text>
            </view>
            <text class="item-source" wx:if="{{item.source}}">{{item.source}}</text>
          </view>
          <!-- 标题 -->
          <text class="item-title">{{item.title}}</text>
          <!-- 摘要预览 -->
          <text class="item-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
          <!-- 底部时间 + 阅读提示 -->
          <view class="item-footer">
            <text class="item-time">{{item.published_at || item.time}}</text>
            <text class="item-action">查看详情 ›</text>
          </view>
        </view>
        <!-- 右侧缩略图 -->
        <view class="item-thumb" wx:if="{{item.image_url}}">
          <image class="thumb-img" src="{{item.image_url}}" mode="aspectFill" lazy-load></image>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <view class="loading-spinner small"></view>
      <text class="load-more-text">加载更多...</text>
    </view>

    <!-- 底部提示 -->
    <view class="list-footer">
      <text class="list-footer-text" wx:if="{{allLoaded}}">
        已加载全部 {{newsList.length}} 篇新闻
      </text>
      <text class="list-footer-text" wx:else>
        上滑加载更多（已显示 {{newsList.length}} 篇）
      </text>
    </view>
  </view>
</view>
