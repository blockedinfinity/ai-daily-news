.page {
  min-height: 100vh;
  padding: 0 20rpx 30rpx;
  background: linear-gradient(180deg, #f0f4ff 0%, #f5f5f5 300rpx);
}

.header {
  padding: 40rpx 10rpx 20rpx;
}

.header .title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111;
  display: block;
  letter-spacing: 1rpx;
}

.header .subtitle {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

/* ===== 日期选择器（与新闻页一致） ===== */
.date-picker {
  margin-bottom: 20rpx;
  position: relative;
}

.date-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.date-trigger-left {
  display: flex;
  align-items: baseline;
}

.date-trigger-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a73e8;
}

.date-trigger-count {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
}

.date-trigger-arrow {
  font-size: 28rpx;
  color: #999;
}

.date-trigger-arrow.expanded {
  transform: rotate(180deg);
}

.date-dropdown {
  position: relative;
  z-index: 100;
}

.date-dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
}

.date-dropdown-list {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  margin-top: 8rpx;
  overflow: hidden;
}

.date-dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.date-dropdown-item:last-child {
  border-bottom: none;
}

.date-dropdown-item.active {
  background: #f0f4ff;
}

.date-dropdown-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.date-dropdown-item.active .date-dropdown-text {
  color: #1a73e8;
  font-weight: 600;
}

.date-dropdown-count {
  font-size: 22rpx;
  color: #999;
}

.loading,
.no-news,
.no-summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1a73e8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}

.icon {
  font-size: 80rpx;
}

.text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}

.generate-btn {
  margin-top: 40rpx;
  background: #1a73e8;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 12rpx;
  border: none;
}

.generate-btn::after {
  border: none;
}

.summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 36rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  line-height: 1.9;
}

.content-text {
  font-size: 30rpx;
  color: #333;
  white-space: pre-wrap;
}
