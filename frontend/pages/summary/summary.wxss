.page {
  min-height: 100vh;
  padding: 0 24rpx 40rpx;
  background: linear-gradient(180deg, #f0f4ff 0%, #f5f5f5 500rpx);
}

/* ===== 日期选择器 ===== */
.date-picker {
  margin-bottom: 24rpx;
  position: relative;
}

.date-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.date-trigger-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a73e8;
}

.date-trigger-arrow {
  font-size: 28rpx;
  color: #999;
}

.date-trigger-arrow.expanded {
  transform: rotate(180deg);
}

.date-dropdown {
  position: relative;
  z-index: 100;
}

.date-dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
}

.date-dropdown-list {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.12);
  margin-top: 8rpx;
  overflow: hidden;
}

.date-dropdown-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.date-dropdown-item:last-child {
  border-bottom: none;
}

.date-dropdown-item.active {
  background: #f0f4ff;
}

.date-dropdown-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.date-dropdown-item.active .date-dropdown-text {
  color: #1a73e8;
  font-weight: 600;
}

/* ===== 加载 / 无项目 ===== */
.loading,
.no-project {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1a73e8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}

.icon {
  font-size: 88rpx;
}

.text {
  font-size: 30rpx;
  color: #555;
  margin-top: 24rpx;
  font-weight: 500;
}

.sub-text {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 12rpx;
}

/* ===== 封面图 ===== */
.cover-wrap {
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-top: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-placeholder-icon {
  font-size: 96rpx;
}

/* ===== 项目标题区 ===== */
.project-header {
  margin-top: 28rpx;
  padding: 0 4rpx;
}

.project-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.project-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 14rpx;
}

.lang-tag {
  font-size: 22rpx;
  color: #fff;
  background: #4a90e2;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.stars-badge {
  font-size: 24rpx;
  color: #f5a623;
  font-weight: 600;
}

.stars-today {
  font-size: 24rpx;
  color: #ff6b6b;
  font-weight: 600;
}

/* ===== 分隔线 ===== */
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #ddd, transparent);
  margin: 28rpx 0;
}

/* ===== 三点介绍 ===== */
.intro-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.intro-item {
  padding: 4rpx 0;
}

.intro-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.intro-icon {
  font-size: 30rpx;
}

.intro-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a73e8;
  letter-spacing: 2rpx;
}

.intro-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  padding-left: 40rpx;
}

.intro-sep {
  height: 1rpx;
  background: #f0f0f0;
  margin: 24rpx 0;
}

/* ===== 底部说明 ===== */
.footer-note {
  text-align: center;
  margin-top: 32rpx;
  padding: 0 20rpx;
}

.footer-note text {
  font-size: 22rpx;
  color: #bbb;
}
