.page {
  min-height: 100vh;
  padding: 0 20rpx 30rpx;
  background: linear-gradient(180deg, #f0f4ff 0%, #f5f5f5 300rpx);
}

.header {
  padding: 40rpx 10rpx 20rpx;
}

.header .title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111;
  display: block;
  letter-spacing: 1rpx;
}

.header .subtitle {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

/* ===== 日期标签（静态，无下拉） ===== */
.date-tag {
  margin-bottom: 20rpx;
}

.date-tag-text {
  display: inline-block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a73e8;
  padding: 18rpx 28rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.loading,
.no-news,
.no-summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1a73e8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}

.icon {
  font-size: 80rpx;
}

.text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}

.generate-btn {
  margin-top: 40rpx;
  background: #1a73e8;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 12rpx;
  border: none;
}

.generate-btn::after {
  border: none;
}

.summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 36rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  line-height: 1.9;
}

.content-text {
  font-size: 30rpx;
  color: #333;
  white-space: pre-wrap;
}
