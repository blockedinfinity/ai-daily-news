.page {
  min-height: 100vh;
  padding: 0 20rpx 30rpx;
}

.header {
  padding: 40rpx 10rpx 20rpx;
}

.header .title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
  display: block;
}

.header .subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

.date-picker {
  margin-bottom: 20rpx;
}

.date-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  padding: 4rpx 0;
}

.date-item {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.date-item.active {
  background: #1a73e8;
  color: #fff;
}

.loading,
.no-news,
.no-summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.loading text {
  font-size: 28rpx;
  color: #999;
}

.icon {
  font-size: 80rpx;
}

.text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}

.generate-btn {
  margin-top: 40rpx;
  background: #1a73e8;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 12rpx;
  border: none;
}

.generate-btn::after {
  border: none;
}

.summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 36rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  line-height: 1.9;
}

.content-text {
  font-size: 30rpx;
  color: #333;
  white-space: pre-wrap;
}
