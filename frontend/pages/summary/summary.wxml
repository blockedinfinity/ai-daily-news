<view class="page">
  <view class="header">
    <text class="title">AI 每日总结</text>
    <text class="subtitle">从今日精华中提炼最重要的洞察</text>
  </view>

  <view class="date-tag" wx:if="{{currentLabel}}">
    <text class="date-tag-text">{{currentLabel}}</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="no-news" wx:elif="{{noNews}}">
    <text class="icon">📭</text>
    <text class="text">该日期暂无新闻</text>
  </view>

  <block wx:elif="{{content}}">
    <view class="summary-card">
      <text class="content-text">{{content}}</text>
    </view>
  </block>

  <view class="no-summary" wx:elif="{{!loading && !content && !noNews}}">
    <text class="icon">🤖</text>
    <text class="text">该日期还没有 AI 总结</text>
    <button class="generate-btn" bind:tap="generate" loading="{{generating}}">
      {{generating ? '生成中...' : '生成总结'}}
    </button>
  </view>
</view>
