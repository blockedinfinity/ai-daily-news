.page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.loading {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  z-index: 10;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1a73e8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}

/* ===== 兜底页 ===== */
.fallback {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  z-index: 20;
}

.fallback-card {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.fallback-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.fallback-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.fallback-desc {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.fallback-url {
  width: 100%;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.fallback-url-text {
  font-size: 22rpx;
  color: #666;
  word-break: break-all;
  line-height: 1.5;
}

.fallback-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.btn-copy,
.btn-open {
  flex: 1;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 12rpx;
  border: none;
  text-align: center;
}

.btn-copy {
  background: #f0f0f0;
  color: #333;
}

.btn-copy::after {
  border: none;
}

.btn-open {
  background: #1a73e8;
  color: #fff;
}

.btn-open::after {
  border: none;
}
