.page {
  padding: 30rpx;
  min-height: 100vh;
  background: #fff;
}

.loading,
.error {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
  font-size: 28rpx;
  color: #999;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
  line-height: 1.5;
  display: block;
}

.time {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
  display: block;
}

.divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 30rpx 0;
}

.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a73e8;
  display: block;
  margin-bottom: 12rpx;
}

.summary-block {
  padding: 20rpx;
  background: #f8f9ff;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.summary-line {
  font-size: 30rpx;
  color: #444;
  line-height: 1.8;
  display: block;
}

.summary-line + .summary-line {
  margin-top: 16rpx;
}

.body {
  font-size: 30rpx;
  color: #333;
  line-height: 1.9;
  display: block;
  margin-bottom: 30rpx;
}

.url-section {
  margin-bottom: 30rpx;
}

.url-text {
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
  display: block;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
}

.footer {
  text-align: center;
}

.link-btn {
  background: #1a73e8;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 12rpx;
  border: none;
}

.link-btn::after {
  border: none;
}
