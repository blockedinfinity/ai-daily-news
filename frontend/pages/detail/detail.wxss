.page {
  padding: 30rpx;
  min-height: 100vh;
  background: #fff;
}

/* ===== 加载态 ===== */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1a73e8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}

/* ===== 错误态 ===== */
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.error-icon {
  font-size: 80rpx;
  color: #ddd;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #e74c3c;
}

/* ===== 标题区 ===== */
.title-section {
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
  line-height: 1.5;
  display: block;
}

.meta-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  gap: 16rpx;
}

.source-tag {
  font-size: 22rpx;
  color: #1a73e8;
  background: #e8f0fe;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 24rpx 0;
}

/* ===== 通用 Section ===== */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* ===== 摘要区 ===== */
.summary-section {
  margin-bottom: 30rpx;
}

.summary-block {
  padding: 24rpx;
  background: linear-gradient(135deg, #f8f9ff 0%, #eef2ff 100%);
  border-radius: 16rpx;
  border-left: 6rpx solid #1a73e8;
}

.summary-item {
  display: flex;
  align-items: flex-start;
}

.summary-item + .summary-item {
  margin-top: 16rpx;
}

.bullet-marker {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background: #1a73e8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.bullet-num {
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
}

.summary-text {
  font-size: 30rpx;
  color: #444;
  line-height: 1.8;
  flex: 1;
}

.summary-text.single {
  display: block;
}

/* ===== 正文区 ===== */
.body-section {
  margin-bottom: 30rpx;
}

.body-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.9;
  display: block;
}

/* ===== 底部操作区 ===== */
.footer {
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #f0f0f0;
}

.btn-primary {
  background: linear-gradient(135deg, #1a73e8, #4285f4);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(26, 115, 232, 0.3);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  margin-top: 16rpx;
  background: #f5f5f5;
  color: #555;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  border: none;
}

.btn-secondary::after {
  border: none;
}
