.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.source-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.source {
  font-size: 24rpx;
  color: #1a73e8;
  background: #e8f0fe;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.time {
  font-size: 22rpx;
  color: #999;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-top: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
